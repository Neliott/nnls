@startuml class-diagram
skinparam monochrome false
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

title NNLS (Not Live Share) - High-Level Class Diagram

' ================= EXTERNAL LIBRARIES =================
enum DeltaType <<external (java-diff-utils)>> {
    INSERT
    DELETE
    CHANGE
}

' ================= COMMON LAYER =================
package "common" {

    class NetworkDelta <<record>> {
        + type: DeltaType
        + pos: int
        + size: int
        + lines: List<String>
    }

    class DiffEngine {
        + {static} computeSha256(lines: List<String>): String
        + {static} computeDeltas(original: List<String>, revised: List<String>): List<NetworkDelta>
        + {static} applyDeltas(original: List<String>, deltas: List<NetworkDelta>): List<String>
        + {static} serializeDeltas(deltas: List<NetworkDelta>): String
        + {static} deserializeDeltas(json: String): List<NetworkDelta>
    }

    NetworkDelta --> DeltaType
    DiffEngine ..> NetworkDelta : maps & formats
}

' ================= SERVER SIDE =================
package "server" {
    class RoomState {
        + filename: String
        + checksum: String
        + fullStateJson: String
        + RoomState(filename: String, checksum: String, fullStateJson: String)
    }

    class PatchResult {
        + status: Status
        + checksum: String
        + fullStateJson: String
        + {static} ok(newChecksum: String): PatchResult
        + {static} outdated(validChecksum: String, fullStateJson: String): PatchResult
        + {static} invalid(): PatchResult
    }

    interface SyncRoom {
        + getRoomCode(): String
        + getState(): RoomState
        + applyPatch(prevChecksum: String, jsonDeltas: String): PatchResult
    }

    interface RoomRegistry {
        + createRoom(filename: String): SyncRoom
        + getRoom(roomCode: String): Optional<SyncRoom>
    }

    class Room {
        - roomCode: String
        - filename: String
        - lines: List<String>
        - checksum: String
        + Room(roomCode: String, filename: String)
        + synchronized applyPatch(prevChecksum: String, jsonDeltas: String): PatchResult
        + synchronized getState(): RoomState
        + getRoomCode(): String
        + getFilename(): String
        + getChecksum(): String
    }

    class RoomManager {
        - rooms: ConcurrentMap<String, Room>
        + createRoom(filename: String): SyncRoom
        + getRoom(roomCode: String): Optional<SyncRoom>
        + removeRoom(roomCode: String): boolean
    }

    class ServerSession {
        - roomRegistry: RoomRegistry
        - currentRoom: SyncRoom
        + ServerSession(roomRegistry: RoomRegistry)
        + handleMessage(requestLine: String): String
        + isInRoom(): boolean
        + close(): void
    }

    class TcpServer {
        - port: int
        - threadPoolSize: int
        - roomManager: RoomManager
        + TcpServer(port: int, threadPoolSize: int)
        + start(): void
        + stop(): void
    }

    class ClientHandler {
        - socket: Socket
        - session: ServerSession
        + ClientHandler(socket: Socket, session: ServerSession)
        + run(): void
    }

    SyncRoom <|.. Room
    RoomRegistry <|.. RoomManager
    RoomManager "1" *-- "0..*" Room : manages
    Room ..> DiffEngine : applies deltas & hashes
    RoomRegistry ..> SyncRoom : creates / lookups
    SyncRoom ..> RoomState : returns
    SyncRoom ..> PatchResult : returns
    ServerSession o-- RoomRegistry : queries / creates
    ServerSession o-- SyncRoom : tracks active room
    ServerSession ..> RoomState : reads
    ServerSession ..> PatchResult : inspects
    TcpServer --> RoomManager : shares
    TcpServer *-- ClientHandler : dispatches
    ClientHandler *-- ServerSession : routes requests
}

' ================= CLIENT SIDE =================
package "client" {

    interface ClientTransport {
        + connect(): void
        + sendRequest(request: String): String
        + isConnected(): boolean
        + close(): void
    }

    interface LocalState {
        + readLocalLines(): List<String>
        + writeLocalLines(lines: List<String>): void
        + computeLocalDiff(): List<NetworkDelta>
        + acceptRemote(remoteLines: List<String>, validChecksum: String): void
        + keepLocalAndRebase(remoteLines: List<String>, validChecksum: String): void
        + updateSyncedState(lines: List<String>, checksum: String): void
        + getLocalPath(): Path
        + getCurrentChecksum(): String
    }

    interface LocalStateFactory {
        + create(localPath: Path): LocalState
    }

    class ServerResponse {
        + {static} parse(rawLine: String): ServerResponse
        + formatErrorMessage(): String
    }

    class TcpClient {
        - host: String
        - port: int
        + connect(): void
        + sendRequest(request: String): String
        + isConnected(): boolean
        + close(): void
    }

    class ClientState {
        - localPath: Path
        - syncedLines: List<String>
        - currentChecksum: String
        + ClientState(localPath: Path)
        + readLocalLines(): List<String>
        + writeLocalLines(lines: List<String>): void
        + computeLocalDiff(): List<NetworkDelta>
        + acceptRemote(remoteLines: List<String>, validChecksum: String): void
        + keepLocalAndRebase(remoteLines: List<String>, validChecksum: String): void
        + updateSyncedState(lines: List<String>, checksum: String): void
        + getLocalPath(): Path
        + getCurrentChecksum(): String
    }

    class ClientRepl {
        - client: ClientTransport
        - stateFactory: LocalStateFactory
        - state: LocalState
        + ClientRepl(client: ClientTransport, stateFactory: LocalStateFactory, in: InputStream, out: OutputStream)
        + start(): void
    }

    ClientTransport <|.. TcpClient
    LocalState <|.. ClientState
    LocalStateFactory ..> LocalState : creates
    ClientState ..> DiffEngine : diffs & hashes
    ClientRepl o-- ClientTransport : transport
    ClientRepl o-- LocalStateFactory : creates state
    ClientRepl o-- LocalState : local state
    ClientRepl ..> ServerResponse : parses responses
    ClientRepl ..> DiffEngine : diffs & serialization
}

' ================= CLI / ENTRYPOINT =================
class Main {
    + {static} main(args: String[]): void
}

class ServerCommand {
    - port: int
    - threads: int
    + run(): void
}

class ClientCommand {
    - host: String
    - port: int
    + run(): void
}

Main -- ServerCommand
Main -- ClientCommand
ServerCommand ..> TcpServer : configures & starts
ClientCommand ..> ClientRepl : configures & starts


' Network Boundary
TcpClient .right.> TcpServer : TCP Stream (Port 4242, UTF-8, "\\n")

' ================= NOTES =================
note right of ServerSession
  <b>Decoupled from Sockets (Critère 21):</b>
  Takes a raw string line, parses it, and returns a response string.
  100% unit-testable with JUnit 5 without opening any network port.
end note

note right of Room
  <b>Thread-Safe Concurrency (Critère 20):</b>
  Synchronized methods ensure atomic patch application
  and hash updates, preventing concurrent edit collisions.
end note

note bottom of ClientState
  Groups disk file I/O, synced memory baseline,
  and local conflict reconciliation strategies.
end note

@enduml
